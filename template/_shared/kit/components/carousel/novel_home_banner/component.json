{
    "id": "novel_home_banner",
    "label_key": "admin/themedesign/pb_block_novel_home_banner",
    "category": "carousel",
    "kind": "carousel",
    "styleMode": "component",
    "peer_styles": [],
    "assets": {
        "css": "style.css",
        "js": "script.js"
    },
    "palette": false,
    "palette_inject": true,
    "props": {
        "bind": {
            "type": "enum",
            "default": "art",
            "values": ["vod", "manga", "art"],
            "trait": "bind"
        },
        "type": {
            "type": "category",
            "mid": 2,
            "default": 0,
            "trait": "category"
        },
        "num": {
            "type": "number",
            "default": 6,
            "min": 1,
            "max": 12,
            "trait": "count"
        },
        "by": {
            "type": "enum",
            "default": "hits_week",
            "values": ["time", "hits", "hits_day", "hits_week", "hits_month", "score"],
            "trait": "sort"
        }
    },
    "context": {
        "pageTypes": ["home", "list", "detail"],
        "requires": []
    }
}

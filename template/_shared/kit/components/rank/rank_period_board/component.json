{
    "id": "rank_period_board",
    "label_key": "admin/themedesign/pb_block_rank_panel",
    "category": "rank",
    "kind": "rank",
    "styleMode": "component",
    "peer_styles": [
        "rank_list/style.css"
    ],
    "assets": {
        "css": "style.css",
        "js": "script.js"
    },
    "props": {
        "title": {
            "type": "string",
            "default": "",
            "trait": "title"
        },
        "type": {
            "type": "category",
            "mid": 1,
            "default": 0,
            "trait": "category"
        },
        "num": {
            "type": "number",
            "default": 20,
            "min": 1,
            "max": 50,
            "trait": "count"
        },
        "period": {
            "type": "enum",
            "default": "week",
            "values": [
                "day",
                "week",
                "month"
            ],
            "trait": "period"
        },
        "mid": {
            "type": "enum",
            "default": 1,
            "values": [
                1,
                2,
                12
            ]
        },
        "hide_title": {
            "type": "boolean",
            "default": false
        }
    },
    "context": {
        "pageTypes": [
            "rank"
        ],
        "requires": []
    }
}

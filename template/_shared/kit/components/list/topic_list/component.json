{
    "id": "topic_list",
    "label_key": "admin/themedesign/pb_block_topic_list",
    "category": "list",
    "kind": "content",
    "palette": false,
    "styleMode": "component",
    "peer_styles": [],
    "assets": {
        "css": "style.css",
        "js": "script.js"
    },
    "props": {
        "num": {
            "type": "number",
            "default": 8,
            "min": 1,
            "max": 50,
            "trait": "count"
        },
        "by": {
            "type": "enum",
            "default": "hits",
            "values": [
                "time",
                "hits",
                "hits_day",
                "hits_week",
                "hits_month",
                "score"
            ],
            "trait": "sort"
        },
        "order": {
            "type": "enum",
            "default": "desc",
            "values": [
                "desc",
                "asc"
            ]
        },
        "paging": {
            "type": "boolean",
            "default": false,
            "trait": "paging"
        },
        "pageurl": {
            "type": "string",
            "default": "topic/index",
            "trait": "pageurl"
        },
        "card": {
            "type": "enum",
            "default": "poster-h",
            "values": [
                "poster-h",
                "poster-v"
            ],
            "trait": "card"
        },
        "ratio": {
            "type": "string",
            "default": "default",
            "trait": "cover_ratio"
        }
    },
    "context": {
        "pageTypes": [
            "home",
            "list",
            "detail"
        ],
        "requires": []
    },
    "data": {
        "source": "mac_topic",
        "listKey": "list",
        "argsFromProps": [
            "num",
            "by",
            "order",
            "paging",
            "pageurl"
        ]

{% import "@shared/components.twig" as c %}
{% import "page-builder-components/_shared/macros.twig" as pb %}
{% set p = props|default({}) %}
{% set recent_num = p.recent_num|default(24) %}
{% set vod_types = mac_type({mid: 1, parent: 0, order: 'desc', by: 'sort'}).list|default([]) %}
{% set art_types = mac_type({mid: 2, order: 'desc', by: 'sort'}).list|default([]) %}
{% set manga_types = mac_type({mid: 12, order: 'desc', by: 'sort'}).list|default([]) %}
{% set recent = mac_vod({num: recent_num, order: 'desc', by: 'time'}).list|default([]) %}
<div class="pb-site-map" data-component="site_map">
  <span class="is-sr-only" hidden aria-hidden="true">{{ c.lazy_img('', '') }}</span>
  <section class="pb-site-map__panel">
    <h2 class="pb-site-map__title" data-lang="string_sec_movie">影视栏目</h2>
    <div class="pb-site-map__chips">
      {% for vo in vod_types %}
      <a class="pb-site-map__chip" href="{{ mac_url_type(vo) }}">{{ vo.type_name }}</a>
      {% else %}
      <p class="pb-site-map__meta" data-lang="map_no_types">暂无栏目</p>
      {% endfor %}
    </div>
  </section>
  <section class="pb-site-map__panel">
    <h2 class="pb-site-map__title" data-lang="site_map_manga">漫画栏目</h2>
    <div class="pb-site-map__chips">
      <a class="pb-site-map__chip" href="{{ mac_url('manga/index') }}" data-lang="string_quanbu">全部</a>
      {% for vo in manga_types %}
      <a class="pb-site-map__chip" href="{{ mac_url_type(vo) }}">{{ vo.type_name }}</a>
      {% endfor %}
    </div>
  </section>
  <section class="pb-site-map__panel">
    <h2 class="pb-site-map__title" data-lang="site_map_novel">小说栏目</h2>
    <div class="pb-site-map__chips">
      <a class="pb-site-map__chip" href="{{ mac_url('art/index') }}" data-lang="string_quanbu">全部</a>
      {% for vo in art_types %}
      <a class="pb-site-map__chip" href="{{ mac_url_type(vo) }}">{{ vo.type_name }}</a>
      {% endfor %}
    </div>
  </section>
  <section class="pb-site-map__panel">
    <h2 class="pb-site-map__title" data-lang="string_sec_channels">站点导航</h2>
    <div class="pb-site-map__chips">
      <a class="pb-site-map__chip" href="{{ mac_url('topic/index') }}" data-lang="string_topic">专题</a>
      <a class="pb-site-map__chip" href="{{ mac_url('actor/index') }}" data-lang="site_map_star">明星</a>
      {% if props.show_live|default(false) %}
      <a class="pb-site-map__chip" href="{{ mac_url('live/show') }}" data-lang="string_live">直播</a>
      {% endif %}
      <a class="pb-site-map__chip" href="{{ mac_url('gbook/index') }}" data-lang="string_ly">留言</a>
      <a class="pb-site-map__chip" href="{{ mac_url('label/rank') }}" data-lang="site_map_rank">排行</a>
    </div>
  </section>
  <section class="pb-site-map__panel">
    <h2 class="pb-site-map__title" data-lang="string_zuijingx">最近更新</h2>
    <ul class="pb-site-map__media-list">
      {% for vo in recent %}
      {# 竖屏封面（短剧等）：分类比例（type_extend.cover）做首屏提示，runtime 按封面实际尺寸写 data-cover-natural 校正 #}
      {% set vo_cover = mac_type_cover(vo.type_id|default(0)) %}
      <li class="pb-site-map__media-item{% if vo_cover and vo_cover.orient == 'v' %} pb-site-map__media-item--portrait{% endif %}" data-cover-auto="shape">
        <a class="pb-site-map__media-link" href="{{ mac_url_vod_detail(vo) }}" title="{{ vo.vod_name }}">
          <span class="pb-site-map__media-pic">{{ pb.lazy_img(vo.vod_pic, vo.vod_name, {loading: 'lazy', decoding: 'async'}) }}</span>
          <span class="pb-site-map__media-name">{{ vo.vod_name }}</span>
        </a>
      </li>
      {% else %}
      <li class="pb-site-map__media-item pb-site-map__media-item--empty"><span class="pb-site-map__meta" data-lang="string_empty_default">暂无内容</span></li>
      {% endfor %}
    </ul>
  </section>
</div>

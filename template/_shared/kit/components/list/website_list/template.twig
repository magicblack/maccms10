{% import "page-builder-components/_shared/macros.twig" as pb %}
{% set num = props.num|default(8) %}
{% set by = props.by|default('hits') %}
{% set order = props.order|default('desc') %}
{% set type_raw = props.type|default(0) %}
{% set type_id = (type_raw == 'current') ? obj.type_id|default(0) : type_raw %}
{% set use_paging = props.paging|default(false) %}
{% set _cover_cls = pb.pb_cover_classes(props) %}
{% set _cover_style = pb.pb_cover_style(props) %}
{% set site_args = {num: num, type: type_id, order: order, by: by} %}
{% if use_paging %}
  {% set site_args = site_args|merge({
    paging: true,
    pageurl: props.pageurl|default('website/show'),
    area: param.area|default(''),
    letter: param.letter|default(''),
    wd: param.wd|default('')
  }) %}
{% endif %}
{% set res = mac_website(site_args) %}
{% set list = res.list|default([]) %}
{% if use_paging %}
  {% set pg = mac_paging(res) %}
{% endif %}
{% if list is not empty %}
<div class="rows pb-website-list {{ _cover_cls }}"{% if _cover_style %} style="{{ _cover_style }}"{% endif %}>
  {% for w in list %}{% include "page-builder-components/_shared/site_row.twig" with {w: w} %}{% endfor %}
</div>
{% endif %}
{% include "page-builder-components/_shared/list_footer.twig" with {
  use_paging: use_paging,
  pg: pg|default(null),
  empty_preset: use_paging ? 'filter' : '',
  empty_title: use_paging ? '暂无符合条件的网址' : '暂无内容',
  empty_title_lang: use_paging ? 'website_empty_filter' : ''
} %}

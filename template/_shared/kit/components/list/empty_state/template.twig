{% set p = props|default({}) %}
{% set title = p.title|default('暂无内容') %}
{% set title_lang = p.title_lang|default('') %}
{% if title_lang == '' and title == '暂无内容' %}{% set title_lang = 'string_empty_default' %}{% endif %}
{% set preset = p.preset|default('') %}
{% set hint = p.hint|default('') %}
{% set hint_lang = p.hint_lang|default('') %}
{% set show_art = p.show_art is defined ? p.show_art : true %}
{% set cta_text = p.cta_text|default('') %}
{% set cta_text_lang = p.cta_text_lang|default('') %}
{% set cta_url = p.cta_url|default(maccms.path|default('/')) %}
{% set illustration = p.illustration|default(pb_empty_illustration|default('svg')) %}
{% set empty_img = p.image|default('') %}
{% if preset == 'developing' and not empty_img %}
  {% set empty_img = maccms.path_tpl ~ 'asset/img/ui/developing.webp' %}
  {% set illustration = 'image' %}
{% elseif preset == 'maintain' and not empty_img %}
  {% set empty_img = maccms.path_tpl ~ 'asset/img/ui/maintain.webp' %}
  {% set illustration = 'image' %}
{% elseif illustration == 'image' and not empty_img %}
  {% set empty_img = maccms.path_tpl ~ 'asset/img/ui/empty.webp' %}
{% endif %}
<div class="pb-empty-state{% if preset %} pb-empty-state--{{ preset }}{% endif %}" data-component="empty_state" role="status">
  {% if show_art %}
  <div class="pb-empty-state__art" aria-hidden="true">
    {% if illustration == 'image' %}
    <img class="pb-empty-state__img" src="{{ empty_img }}" alt="" width="96" height="96" decoding="async">
    {% else %}
{# Themeable empty illustration — colors follow --c-accent #}
<svg class="pb-empty-state__svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="160" height="160" role="img" aria-hidden="true" focusable="false">
  <ellipse cx="100" cy="168" rx="62" ry="14" fill="color-mix(in srgb, var(--c-accent) 14%, #f3f5f7)"/>
  <circle cx="42" cy="48" r="8" fill="color-mix(in srgb, var(--c-accent) 22%, #dbe4ea)" opacity=".7"/>
  <circle cx="168" cy="56" r="10" fill="color-mix(in srgb, var(--c-accent) 35%, #ffffff)" opacity=".85"/>
  <path d="M34 72l10-16 10 16z" fill="var(--c-accent)" opacity=".55"/>
  <rect x="156" y="110" width="14" height="14" rx="3" transform="rotate(20 163 117)" fill="color-mix(in srgb, var(--c-accent) 22%, #dbe4ea)" opacity=".55"/>
  <rect x="48" y="52" width="104" height="86" rx="16" fill="color-mix(in srgb, var(--c-accent) 35%, #ffffff)"/>
  <rect x="52" y="56" width="96" height="78" rx="13" fill="var(--c-accent)"/>
  <rect x="62" y="66" width="76" height="50" rx="8" fill="#111827"/>
  <circle cx="78" cy="46" r="4" fill="#1f2329"/>
  <circle cx="122" cy="46" r="4" fill="#1f2329"/>
  <path d="M78 46c8-18 36-18 44 0" stroke="#1f2329" stroke-width="3" fill="none" stroke-linecap="round"/>
  <rect x="88" y="138" width="24" height="8" rx="3" fill="var(--c-accent)"/>
  <rect x="78" y="146" width="44" height="8" rx="4" fill="color-mix(in srgb, var(--c-accent) 35%, #ffffff)"/>
  <path d="M28 148c18-4 28 10 24 22-16 2-28-8-24-22z" fill="color-mix(in srgb, var(--c-accent) 22%, #dbe4ea)" opacity=".85"/>
  <path d="M172 148c-18-4-28 10-24 22 16 2 28-8 24-22z" fill="color-mix(in srgb, var(--c-accent) 35%, #ffffff)" opacity=".9"/>
</svg>
    {% endif %}
  </div>
  {% endif %}
  <p class="pb-empty-state__title"{% if title_lang and mac_i18n_key(title, title_lang) %} data-lang="{{ title_lang }}"{% endif %}>{{ title }}</p>
  {% if hint %}
  <p class="pb-empty-state__hint"{% if hint_lang and mac_i18n_key(hint, hint_lang) %} data-lang="{{ hint_lang }}"{% endif %}>{{ hint }}</p>
  {% endif %}
  {% if cta_text %}
  <a class="pb-empty-state__cta" href="{{ cta_url }}"{% if cta_text_lang and mac_i18n_key(cta_text, cta_text_lang) %} data-lang="{{ cta_text_lang }}"{% endif %}>{{ cta_text }}</a>
  {% endif %}
</div>

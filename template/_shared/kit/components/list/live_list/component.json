{
    "id": "live_list",
    "label_key": "admin/themedesign/pb_block_live_list",
    "category": "list",
    "kind": "content",
    "palette": false,
    "styleMode": "component",
    "peer_styles": [],
    "assets": {
        "css": "style.css",
        "js": "script.js"
    },
    "props": {
        "num": {
            "type": "number",
            "default": 8,
            "min": 1,
            "max": 50,
            "trait": "count"
        },
        "paging": {
            "type": "boolean",
            "default": false,
            "trait": "paging"
        },
        "pageurl": {
            "type": "string",
            "default": "live/show",
            "trait": "pageurl"
        },
        "cate": {
            "type": "number",
            "default": 0,
            "min": 0,
            "trait": "cate"
        },
        "card": {
            "type": "enum",
            "default": "poster-h",
            "values": [
                "poster-h",
                "poster-v"
            ],
            "trait": "card"
        },
        "ratio": {
            "type": "string",
            "default": "default",
            "trait": "cover_ratio"
        }
    },
    "context": {
        "pageTypes": [
            "home",
            "list",
            "detail"
        ],
        "requires": []
    },
    "data": {
        "source": "mac_live_list",
        "listKey": "list",
        "argsFromProps": [
            "num",
            "paging",
            "pageurl",
            "cate"
        ]
    }
}

{% import "page-builder-components/_shared/macros.twig" as pb %}
{% set _ph = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' %}
<article class="pb-topic-card" data-mid="3" data-id="{{ vo.topic_id }}">
  <a class="pb-topic-card__pic" href="{{ mac_url_topic_detail(vo) }}" title="{{ vo.topic_name }}">
    {{ pb.lazy_img(vo.topic_pic, vo.topic_name, {placeholder: _ph}) }}
  </a>
  <div class="pb-topic-card__title"><a href="{{ mac_url_topic_detail(vo) }}">{{ vo.topic_name }}</a></div>
  <div class="pb-topic-card__meta">{{ vo.topic_sub }}</div>
</article>

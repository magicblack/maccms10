{#
  登录/注册等认证页 —— 整页布局，无站点头尾
#}
{% import "@shared/components.twig" as c %}
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
{# IE/360 兼容模式自动拦截（纯前端，须在 PB CSS 之前） #}
<script src="{{ maccms.path_tpl }}page-builder-components/_shared/js/browser-ie-detect.js"></script>
{# 强制 360/搜狗/QQ 等双核浏览器使用高速内核，避免被兼容模式(IE内核)渲染导致前端异常 #}
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="renderer" content="webkit">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ maccms.site_name }}{% endblock %}</title>
{% block meta %}
<meta name="keywords" content="{{ maccms.site_keywords }}">
<meta name="description" content="{{ maccms.site_description }}">
{% endblock %}
{% block theme_styles %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/tokens.css">
{% set _pb_td_override = mac_theme_override_css_href() %}
{% if _pb_td_override %}<link rel="stylesheet" href="{{ _pb_td_override }}">
{% endif %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-shell.css">
{% endblock %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-responsive.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/auth_page/style.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/auth_form/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/auth_page/script.js" defer></script>
<script src="{{ maccms.path_tpl }}page-builder-components/auth_form/script.js" defer></script>
{{ c.jsvar(maccms, csrf_token|default(''), user.user_id|default(0)) }}
{% block head %}{% endblock %}
</head>
<body class="pbs-body pbs-body--auth{% block page_class %}{% endblock %}" data-mid="{{ maccms.mid|default(0) }}" data-aid="{{ maccms.aid|default(0) }}">
<main id="main" class="pbs-main pbs-main--auth">{% block content %}{% endblock %}</main>
{{ c.runtime(maccms.path, '', '', maccms.path_tpl|default('')) }}
{% block foot %}{% endblock %}
</body>
</html>

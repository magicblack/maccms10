                        }
                    ]
                }
            }
        ],
        "sidebar": [],
        "footer": [
            {
                "component": "site_footer",
                "props": {
                    "variant": "default",
                    "copyright": "",
                    "show_nav": true,
                    "show_friends": true,
                    "logo": ""
                }
            }
        ]
    }

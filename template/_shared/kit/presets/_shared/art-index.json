{
    "template": "art/index",
    "layout": "base",
    "page_type": "list",
    "layout_mod": "novel-home",
    "regions": {
        "site_header": [
            {
                "component": "site_nav",
                "props": {
                    "max": 8,
                    "show_search": true,
                    "type_ids": []
                }
            }
        ],
        "hero": [
            {
                "component": "novel_genre_nav",
                "props": {
                    "num": 16,
                    "more_url": "art/type"
                }
            }
        ],
        "channel": [],
        "content": [
            {
                "component": "novel_home_dock",
                "props": []
            },
            {
                "component": "novel_home_rank",
                "props": {
                    "num": 10
                }
            },
            {
                "component": "section",
                "props": {
                    "variant": "card",

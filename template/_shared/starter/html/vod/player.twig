{#
  Starter T0: vod 单页播放器。

  Vod::player() 在权限校验通过（无密码限制，或 vod_pwd_play 已过 session 校验）后渲染，
  嵌在 vod_player 组件的 <iframe id="player_if"> 里（见 All.php label_vod_play()
  组装的 player_js 在需要门控时改指向这个路由）。不带站点头尾／导航。

  points/VIP 无试看时 label_vod_play() 在 pe==0 分支已提前 return（player_data/js
  直接清空，门栏由外层 vod_player 组件自己画），根本不会打到这条路由；这里只会在
  vod_pwd_play／trysee／copyright 三种情况下被打到，此时 player_data/player_js
  已经是真实播放器，原样输出即可。
#}
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<script src="{{ maccms.path_tpl }}page-builder-components/_shared/js/browser-ie-detect.js"></script>
{# 强制 360/搜狗/QQ 等双核浏览器使用高速内核，避免播放器被兼容模式(IE内核)渲染导致播放异常 #}
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="renderer" content="webkit">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{{ maccms.site_name|default('') }}</title>
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/tokens.css">
{% set _pb_td_override = mac_theme_override_css_href() %}
{% if _pb_td_override %}<link rel="stylesheet" href="{{ _pb_td_override }}">{% endif %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-shell.css">
<style>
html, body { margin: 0; padding: 0; height: 100%; background: #000; }
</style>
{% import "@shared/components.twig" as c %}
{{ c.jsvar(maccms, csrf_token|default(''), user.user_id|default(0)) }}
</head>
<body class="pbs-body pb-components-only page-vod-player-frame" data-mid="{{ maccms.mid|default(0) }}" data-aid="{{ maccms.aid|default(0) }}">
{{ player_data|raw }}
{{ player_js|raw }}
<script>
{# 本页嵌在播放页 iframe 里，dplayer.html 再嵌一层：它的 postMessage 只发给本页，
   这里双向转发，播放页的进度记忆（vod-play-progress.js）/ 线路容灾才收得到 #}
(function (w) {
  if (w.parent === w) return;
  w.addEventListener('message', function (ev) {
    if (ev.origin !== w.location.origin) return;
    var d = ev.data;
    if (!d || typeof d !== 'object') return;
    if (d.source === 'mac-player' && ev.source !== w.parent) {
      try { w.parent.postMessage(d, w.location.origin); } catch (e) {}
    } else if (d.source === 'mac-play-parent' && ev.source === w.parent) {
      var fs = document.getElementsByTagName('iframe');
      for (var i = 0; i < fs.length; i++) {
        try { fs[i].contentWindow.postMessage(d, w.location.origin); } catch (e2) {}
      }
    }
  });
})(window);
</script>
{{ c.runtime(maccms.path, '', '', maccms.path_tpl|default('')) }}
</body>
</html>

{#
  Starter T0: vod 播放页访问密码门。

  由 Vod::player() 在 vod_pwd_play 未过 session 校验时渲染，嵌在 vod_player 组件的
  <iframe id="player_if"> 里（见 All.php label_vod_play() 组装的 player_js），
  所以不带站点头尾／导航，只是一个填满 iframe 的独立小页面。
#}
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<script src="{{ maccms.path_tpl }}page-builder-components/_shared/js/browser-ie-detect.js"></script>
{# 强制 360/搜狗/QQ 等双核浏览器使用高速内核，避免密码门被兼容模式(IE内核)渲染导致前端异常 #}
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="renderer" content="webkit">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{{ maccms.site_name|default('') }}</title>
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/tokens.css">
{% set _pb_td_override = mac_theme_override_css_href() %}
{% if _pb_td_override %}<link rel="stylesheet" href="{{ _pb_td_override }}">{% endif %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-shell.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-t0.css?v=2">
{% import "@shared/components.twig" as c %}
{{ c.jsvar(maccms, csrf_token|default(''), user.user_id|default(0)) }}
</head>
<body class="pbs-body pb-components-only page-vod-pwd-gate" data-mid="{{ maccms.mid|default(0) }}" data-aid="{{ maccms.aid|default(0) }}">
<main class="pb-t0-pwd-standalone">
  <div class="pb-t0__panel">
    <h1 class="pb-t0__panel-title" data-lang="dear_password">亲爱的访问此数据需要密码哦</h1>
    {% set pwd_play_url = obj.vod_pwd_play_url|default('')|trim %}
    {% set pwd_play_url_lc = pwd_play_url|lower %}
    {% if pwd_play_url and not (pwd_play_url_lc starts with 'http://' or pwd_play_url_lc starts with 'https://' or pwd_play_url_lc starts with '//' or pwd_play_url starts with '/') %}
      {# admin often pastes a bare domain (e.g. "qq.com/xxx"); without a scheme the browser resolves href as same-site relative and 404s #}
      {% set pwd_play_url = 'https://' ~ pwd_play_url %}
    {% endif %}
    {{ c.pwd_form(1, obj.vod_id|default(0), 4, {
      class: 'pb-t0-pwd__form',
      input_class: 'pb-t0-pwd__input',
      button_class: 'pb-t0__btn pb-t0-pwd__btn',
      tip_class: 'pb-t0-pwd__tip',
      tip_url: pwd_play_url
    }) }}
  </div>
</main>
{{ c.runtime(maccms.path, '', '', maccms.path_tpl|default('')) }}
</body>
</html>

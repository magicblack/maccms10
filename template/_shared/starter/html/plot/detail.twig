{# Starter T0: plot detail #}
{% extends "layout/base.twig" %}
{% import "@shared/components.twig" as c %}
{% block layout_mod %} detail{% endblock %}
{% block page_class %} pb-components-only page-plot-detail{% endblock %}
{% block theme_styles %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/tokens.css">
{% set _pb_td_override = mac_theme_override_css_href() %}
{% if _pb_td_override %}<link rel="stylesheet" href="{{ _pb_td_override }}">{% endif %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-shell.css">
{% endblock %}
{% block title %}{{ obj.vod_name|default('') }} 分集剧情{% endblock %}
{% block head %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/_shared/css/peers.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-t0.css?v=2">

<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/site_nav/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/site_nav/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/notify_bell/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/notify_bell/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/header_decor/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/header_decor/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/channel_strip/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/channel_strip/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/empty_state/style.css">
{% endblock %}

{% block site_header %}
  {% include 'page-builder-components/site_nav/template.twig' with {props: { max: 8, show_search: true, type_ids: [] }} %}
{% endblock %}
{% block channel %}
  {% include 'page-builder-components/channel_strip/template.twig' with {props: { compact: false, chip_limit: 11, show_icons: true, show_more: true, type_ids: [] }} %}
{% endblock %}
{% block content %}
{% set plots = obj.vod_plot_list|default({}) %}
{% set page = param.page|default(1) %}
{% if page < 1 %}{% set page = 1 %}{% endif %}
{% set cur = plots[page]|default(plots[1]|default({})) %}
<section class="pb-t0">
  <nav class="pb-t0__crumb" aria-label="breadcrumb">
    <a href="{{ maccms.path|default('/') }}" data-lang="string_home">首页</a>
    <span class="pb-t0__sep">/</span>
    <a href="{{ mac_url_vod_detail(obj) }}">{{ obj.vod_name|default('') }}</a>
    <span class="pb-t0__sep">/</span>
    <span data-lang="vod_plot">分集剧情</span>
  </nav>
  <header class="pb-t0__hero">
    <p class="pb-t0__kicker" data-lang="vod_plot">分集剧情</p>
    <h1 class="pb-t0__title">{{ obj.vod_name|default('') }}{% if cur.name|default('') %} · {{ cur.name }}{% endif %}</h1>
    <div class="pb-t0__actions">
      <a class="pb-t0__btn" href="{{ mac_url_vod_detail(obj) }}" data-lang="vod_view_detail">查看详情</a>
    </div>
  </header>
  <div class="pb-t0__panel pb-t0-plot__media">
    <div class="pb-t0-plot__cover">{{ c.lazy_img(obj.vod_pic|default(''), obj.vod_name|default('')) }}</div>
    <div>
      <h2 class="pb-t0__panel-title" data-lang="{{ cur.name|default('') ? '' : 'plot_cur_episode_default' }}">{{ cur.name|default('本集剧情') }}</h2>
      {% if cur.detail|default('') %}
      <div class="pb-t0-plot__body" style="white-space:pre-wrap">{{ cur.detail }}</div>
      {% else %}
      <div class="pb-t0__empty" style="padding:16px 0;align-items:flex-start;text-align:left">
        <p data-lang="plot_no_summary">本集暂无剧情简介</p>
      </div>
      {% endif %}
      <div class="pb-t0-plot__nav">
        {% if plots[page - 1] is defined %}
        <a class="pb-t0__btn pb-t0__btn--ghost" href="{{ mac_url_plot_detail(obj, {page: page - 1}) }}" data-lang="string_syj">上一集</a>
        {% endif %}
        {% if plots[page + 1] is defined %}
        <a class="pb-t0__btn" href="{{ mac_url_plot_detail(obj, {page: page + 1}) }}" data-lang="string_xyj">下一集</a>
        {% endif %}
      </div>
    </div>
  </div>
  {% if plots %}
  <div class="pb-t0__panel">
    <h2 class="pb-t0__panel-title" data-lang="string_vod_bfdz">选集</h2>
    <div class="pb-t0-plot__eps">
      {% for k, ep in plots %}
      <a class="pb-t0-plot__ep{% if k == page %} is-active{% endif %}" href="{{ mac_url_plot_detail(obj, {page: k}) }}">{{ ep.name|default(k) }}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
{% endblock %}
{% block sidebar %}{% endblock %}
{% block footer %}{% endblock %}

{# Starter T0: plot index #}
{% extends "layout/base.twig" %}
{% import "@shared/components.twig" as c %}
{% block layout_mod %} list{% endblock %}
{% block page_class %} pb-components-only page-plot{% endblock %}
{% block theme_styles %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/tokens.css">
{% set _pb_td_override = mac_theme_override_css_href() %}
{% if _pb_td_override %}<link rel="stylesheet" href="{{ _pb_td_override }}">{% endif %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-shell.css">
{% endblock %}
{% block title %}{{ maccms.page_title|default('分集剧情') }}{% endblock %}
{% block head %}
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/_shared/css/peers.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}asset/css/pb-t0.css?v=2">

<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/site_nav/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/site_nav/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/notify_bell/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/notify_bell/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/header_decor/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/header_decor/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/channel_strip/style.css">
<script src="{{ maccms.path_tpl }}page-builder-components/channel_strip/script.js" defer></script>
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/empty_state/style.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/paging/style.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/site_footer/style.css">
<link rel="stylesheet" href="{{ maccms.path_tpl }}page-builder-components/bottom_nav/style.css">
{% endblock %}

{% block site_header %}
  {% include 'page-builder-components/site_nav/template.twig' with {props: { max: 8, show_search: true, type_ids: [] }} %}
{% endblock %}
{% block channel %}
  {% include 'page-builder-components/channel_strip/template.twig' with {props: { compact: false, chip_limit: 11, show_icons: true, show_more: true, type_ids: [] }} %}
{% endblock %}
{% block content %}
{% set res = mac_vod({num: 30, paging: true, pageurl: 'plot/index', type: 'all', plot: 1, order: 'desc', by: 'time'}) %}
{% set list = res.list|default([]) %}
{% set pg = mac_paging(res) %}
<section class="pb-t0" aria-labelledby="pb-t0-plot-title">
  <header class="pb-t0__hero">
    <p class="pb-t0__kicker" data-lang="string_plot">剧情</p>
    <h1 class="pb-t0__title" id="pb-t0-plot-title" data-lang="vod_plot">分集剧情</h1>
    <p class="pb-t0__desc" data-lang="plot_index_desc">按集查看剧情摘要，快速回顾剧情走向。</p>
  </header>
  {% if list %}
  <div class="pb-t0__grid" style="padding:0 16px">
    {% for vo in list %}
    <a class="pb-t0__card" href="{{ mac_url_plot_detail(vo) }}" title="{{ vo.vod_name }}">
      <span class="pb-t0__thumb">
        {{ c.lazy_img(vo.vod_pic, vo.vod_name) }}
        {% if vo.vod_remarks %}<span class="pb-t0__badge">{% include "page-builder-components/_shared/episode_remarks.twig" with {remarks: vo.vod_remarks} only %}</span>{% endif %}
      </span>
      <h2 class="pb-t0__card-title">{{ vo.vod_name }}</h2>
    </a>
    {% endfor %}
  </div>
  {% include 'page-builder-components/paging/template.twig' with {props: {pg: pg}} %}
  {% else %}
  <div class="pb-t0__panel">
    <div class="pb-t0__empty">
      <svg class="pb-t0__empty-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 19.5V6a2 2 0 0 1 2-2h9"/><path d="M8 6h12v13.5a1.5 1.5 0 0 1-1.5 1.5H8"/><path d="M8 10h8M8 14h5"/></svg>
      <p data-lang="plot_list_empty_title">暂无分集剧情</p>
      <a class="pb-t0__btn" href="{{ maccms.path|default('/') }}" data-lang="plot_back_home">回首页</a>
    </div>
  </div>
  {% endif %}
</section>
{% endblock %}
{% block sidebar %}{% endblock %}
{% block footer %}
  {% include 'page-builder-components/site_footer/template.twig' with {props: { variant: 'default', copyright: '', show_nav: true, show_friends: true, logo: '' }} %}
  {% include 'page-builder-components/bottom_nav/template.twig' with {props: {  }} %}
{% endblock %}

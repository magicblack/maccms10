{#
  maccms Theme Contract v1 —— 共用 Twig 元件庫

  設計取向：**保證行為契約正確，不規定長相**。
  每個 macro 只負責把 docs/theme-contract-v1.md 要求的 hook（data-lang / data-original /
  .mac_ulog / .digg_link / data-mac-*-form / player_data 位置 …）輸出對，
  class 與結構一律由主題透過 opts 決定。
  所以兩套用同一份元件庫的主題，長相可以完全不同。

  分層原則（決定一個東西該不該進這個檔案）：
    進來 —— 寫錯就「功能壞掉」的：行為 hook、播放器掛載點、選集連結的
            sid/nid 語義、篩選 URL 的參數合併、分頁 URL、表單欄位名。
    不進 —— 寫錯只是「不好看」的：版面、卡片、導覽、排版、配色。
            那些留在各主題自己的模板裡，才有「結構級不同」可言。

  用法：
    {% import "@shared/components.twig" as c %}
    {{ c.runtime(maccms.path) }}
    {{ c.lazy_img(vo.vod_pic, vo.vod_name, {class: 'my-thumb'}) }}
    {{ c.fav_button(1, vo.vod_id, {class: 'my-fav', on_class: 'my-fav--on'}) }}
#}

{# ============================================================
   1. 執行期
   ============================================================ #}

{# 全域啟動變數。**必須放在 <head>，且早於任何 player_js 輸出。**

   為什麼是契約的一部分：static/js/player.js 與 static/player/*.js 是**核心資產**，
   三套主題共用同一份，主題無權改。它們對宿主頁面有兩個硬依賴：
     · MacPlayer.Init() 讀全域 maccms.path 組 this.Path；
       static/player/dplayer.js 也讀 maccms.path，
       static/player/dplayer.html 讀 parent.maccms.path / path_assets。
     · MacPlayer.Play() 用 $('.MacPlayer')、$('#playleft')、$('#buffer')。
   任一個缺席就丟例外，緊接著那句 document.write('<script src=…/<from>.js>')
   不會執行 —— 播放器連 DOM 節點都不會出現，頁面看起來就是「視頻不能播放」。

   default 主題靠 public/jsvar.html 與 asset/js/jquery.js 供給這兩樣；Twig 主題
   沒有那些資產，所以統一由本 macro 補齊，主題只要在 <head> 呼叫一次即可。

   jQuery：player.js 全部只用到 attr / get / show / hide 四個方法，這裡給等價
   shim，不引第三方（_shared 的原則是零依賴，見 mac-theme-runtime.js 檔頭）。
   主題若自行載入真 jQuery，jQuery 會覆寫 window.$，行為不變。

   m    = maccms（控制器指派的站點變數陣列）
   csrf = csrf_token
   uid  = 當前登入會員 user_id（0 = 未登入）。runtime 用它判斷「需登入」操作要不要
          先攔下來彈登入框；不傳的話所有訪客都會被當成未登入，收藏／評論會多繞一趟
          伺服器往返才發現沒登入。 #}
{% macro jsvar(m, csrf, uid) %}
<script>
window.maccms = {
    "path": (function(){var p="{{ m.path|default('/')|e('js') }}".replace(/\/+$/,''); return (p==='/'||p==='') ? '' : p;})(),
    "path_assets": "{{ m.path|default('/')|e('js') }}",
    "path_tpl": "{{ m.path_tpl|default('')|e('js') }}",
    "base_url": "{{ m.http_type|default('')|e('js') }}{{ m.site_url|default('')|e('js') }}",
    "mid": "{{ m.mid|default('')|e('js') }}",
    "aid": "{{ m.aid|default('')|e('js') }}",
    "url": "{{ m.site_url|default('')|e('js') }}",
    "wapurl": "{{ m.site_wapurl|default('')|e('js') }}",
    "mob_status": "{{ m.mob_status|default('')|e('js') }}",
    "site_name": "{{ m.site_name|default('')|e('js') }}",
    "csrfToken": "{{ csrf|default('')|e('js') }}",
    "userId": "{{ uid|default(0)|e('js') }}"
};
window.MAC_PATH = window.maccms.path;
if (typeof window.$ === 'undefined') {
    window.$ = function (sel) {
        var els = typeof sel === 'string' ? document.querySelectorAll(sel) : (sel ? [sel] : []);
        return {
            get: function (i) { return els[i]; },
            attr: function (k, v) {
                if (v === undefined) { return els[0] ? els[0].getAttribute(k) : undefined; }
                for (var i = 0; i < els.length; i++) { els[i].setAttribute(k, v); }
                return this;
            },
            show: function () { for (var i = 0; i < els.length; i++) { els[i].style.display = ''; } return this; },
            hide: function () { for (var i = 0; i < els.length; i++) { els[i].style.display = 'none'; } return this; }
        };
    };
}
</script>
{% endmacro %}

{# 引入行為 runtime。放在 </body> 前。

   base         = maccms.path（站點根）
   lang_path    = 選填。語言檔目錄；預設隨載入分支。
   tpl_path     = 選填，**opt-out**。非空 → <tpl_path>asset/js/mac-theme-runtime.js
                  （存量 twigspike / phub 自帶副本）。
   pb_path_tpl  = 選填。PB 主題傳 maccms.path_tpl（宏無調用方 context，不可在宏內讀 maccms）。

   載入優先：tpl_path → 主題 asset；pb_path_tpl → page-builder-components/_shared；
   否則 → kit/shared 源碼路徑。 #}
{% macro runtime(base, lang_path, tpl_path, pb_path_tpl) %}
{% set root = base|default('/') %}
{% set tpl = tpl_path|default('') %}
{% set pb_tpl = pb_path_tpl|default('') %}
{% if tpl != '' %}
<script src="{{ tpl }}asset/js/mac-theme-runtime.js"
        data-base="{{ root }}"
        data-lang-path="{{ lang_path|default(tpl ~ 'asset/language/') }}"></script>
{% elseif pb_tpl != '' %}
<script src="{{ pb_tpl }}page-builder-components/_shared/js/mac-theme-runtime.js"
        data-base="{{ root }}"
        data-lang-path="{{ lang_path|default(pb_tpl ~ 'page-builder-components/_shared/language/') }}"></script>
{% else %}
<script src="{{ root }}template/_shared/kit/shared/js/mac-theme-runtime.js"
        data-base="{{ root }}"
        data-lang-path="{{ lang_path|default(root ~ 'template/_shared/kit/shared/language/') }}"></script>
{% endif %}
{% endmacro %}

{# 薄壳 / PB 主题：顶栏交互 + 登录弹窗开关（与 runtime 分离，避免存量主题重复绑定）。
   放在 </body> 前、runtime 之后。 #}
{% macro member_pay_hooks(user) %}
{% set api_base = maccms.path|trim('/') ~ '/api.php' %}
data-url-login="{{ mac_url('user/login') }}"
data-url-user-upgrade="{{ mac_url('user/upgrade') }}"
data-is-login="{% if user.user_id|default(0) %}1{% else %}0{% endif %}"
data-url-recharge-config="{{ api_base }}/payment/get_config"
data-url-buy="{{ api_base }}/order/create"
data-url-gopay="{{ api_base }}/payment/gopay"
data-url-order-query="{{ api_base }}/order/check_status"
data-url-upgrade-data="{{ api_base }}/user/ajax_upgrade_data"
data-url-benefits="{{ mac_url('user/benefits') }}"
data-path-tpl="{{ maccms.path_tpl|default('') }}"
data-recharge-img-base="{{ maccms.path_tpl|default('') }}page-builder-components/_shared/img/recharge/"
{% endmacro %}

{# path_tpl 须由调用方传入：Twig 宏隔离 context，读不到 maccms.path_tpl #}
{% macro chrome(base, path_tpl) %}
{% set root = base|default('/') %}
{% set tpl = path_tpl|default('') %}
{% if tpl != '' %}
<link rel="stylesheet" href="{{ tpl }}page-builder-components/_shared/css/dialogs.css">

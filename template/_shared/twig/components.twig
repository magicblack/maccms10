<script src="{{ tpl }}page-builder-components/pay_shell/assets/js/coupon.js" defer></script>
<script src="{{ tpl }}page-builder-components/_shared/js/recharge-sheet.js" defer></script>
<script src="{{ tpl }}page-builder-components/_shared/js/popedom.js" defer></script>
<script src="{{ tpl }}page-builder-components/notify_bell/script.js" defer></script>
<script src="{{ tpl }}page-builder-components/auth_page/script.js" defer></script>
